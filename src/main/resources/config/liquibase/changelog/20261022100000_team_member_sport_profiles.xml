<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20261022100000-1" author="system">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="team_members"/>
            <not>
                <columnExists tableName="team_members" columnName="sport_profiles"/>
            </not>
        </preConditions>
        <addColumn tableName="team_members">
            <column name="sport_profiles" type="text"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
