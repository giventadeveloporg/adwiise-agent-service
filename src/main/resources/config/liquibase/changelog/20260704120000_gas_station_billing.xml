<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Billing column on tenant_organization stays. Gas location billing column is retired;
         retail_location.included_in_subscription is the live counter. -->

    <changeSet id="20260704120000-1" author="system">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="tenant_organization"/>
            <not>
                <columnExists tableName="tenant_organization" columnName="stripe_subscription_id"/>
            </not>
        </preConditions>
        <sql><![CDATA[
            ALTER TABLE public.tenant_organization
                ADD COLUMN IF NOT EXISTS stripe_subscription_id character varying(255);
            COMMENT ON COLUMN public.tenant_organization.stripe_subscription_id IS 'Stripe subscription id for the tenant platform subscription (retail per-location billing). Customer id lives in stripe_customer_id.';
        ]]></sql>
    </changeSet>

    <changeSet id="20260704120000-2" author="system">
        <validCheckSum>ANY</validCheckSum>
        <comment>No-op. gas_station_location.included_in_subscription is retired; use retail_location.</comment>
        <sql>SELECT 1;</sql>
    </changeSet>

</databaseChangeLog>
