<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20261115040000-1" author="system">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="event_sponsors" columnName="ocr_text_from_sponsor_images"/>
            <not>
                <columnExists tableName="event_sponsors" columnName="ocr_text_from_images_upload"/>
            </not>
        </preConditions>
        <renameColumn tableName="event_sponsors" oldColumnName="ocr_text_from_sponsor_images" newColumnName="ocr_text_from_images_upload" columnDataType="text"/>
    </changeSet>

    <changeSet id="20261115040000-2" author="system">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="event_sponsors" columnName="ocr_text"/>
            <not>
                <columnExists tableName="event_sponsors" columnName="ocr_text_from_images_upload"/>
            </not>
        </preConditions>
        <renameColumn tableName="event_sponsors" oldColumnName="ocr_text" newColumnName="ocr_text_from_images_upload" columnDataType="text"/>
    </changeSet>

    <changeSet id="20261115040000-3" author="system">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="event_details" columnName="ocr_text"/>
            <not>
                <columnExists tableName="event_details" columnName="ocr_text_from_images_upload"/>
            </not>
        </preConditions>
        <renameColumn tableName="event_details" oldColumnName="ocr_text" newColumnName="ocr_text_from_images_upload" columnDataType="text"/>
    </changeSet>

    <changeSet id="20261115040000-4" author="system">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="gallery_album" columnName="ocr_text"/>
            <not>
                <columnExists tableName="gallery_album" columnName="ocr_text_from_images_upload"/>
            </not>
        </preConditions>
        <renameColumn tableName="gallery_album" oldColumnName="ocr_text" newColumnName="ocr_text_from_images_upload" columnDataType="text"/>
    </changeSet>

    <changeSet id="20261115040000-5" author="system">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="focus_group" columnName="ocr_text"/>
            <not>
                <columnExists tableName="focus_group" columnName="ocr_text_from_images_upload"/>
            </not>
        </preConditions>
        <renameColumn tableName="focus_group" oldColumnName="ocr_text" newColumnName="ocr_text_from_images_upload" columnDataType="text"/>
    </changeSet>

    <changeSet id="20261115040000-6" author="system">
        <sql>
            COMMENT ON COLUMN public.event_sponsors.ocr_text_from_images_upload IS
                'Text read from uploaded sponsor images. Copied into search_text so visitors can find the sponsor by words on those images.';
            COMMENT ON COLUMN public.event_details.ocr_text_from_images_upload IS
                'Text read from uploaded event images. Copied into search_text.';
            COMMENT ON COLUMN public.gallery_album.ocr_text_from_images_upload IS
                'Text read from the album cover image. Copied into search_text.';
            COMMENT ON COLUMN public.focus_group.ocr_text_from_images_upload IS
                'Text read from the focus group cover image. Copied into search_text.';
        </sql>
    </changeSet>
</databaseChangeLog>
