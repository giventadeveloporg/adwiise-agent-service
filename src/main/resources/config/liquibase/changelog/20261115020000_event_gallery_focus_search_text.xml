        <preConditions onFail="MARK_RAN">
            <tableExists tableName="gallery_album"/>
            <not><columnExists tableName="gallery_album" columnName="search_text"/></not>
        </preConditions>
        <addColumn tableName="gallery_album">
            <column name="search_text" type="text"><constraints nullable="true"/></column>
        </addColumn>
    </changeSet>
    <changeSet id="20261115020000-6" author="system">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="gallery_album" columnName="search_text"/>
        </preConditions>
        <sql>
            UPDATE public.gallery_album
            SET search_text = lower(trim(regexp_replace(
                concat_ws(' ', nullif(trim(title), ''), nullif(trim(description), ''), nullif(trim(event_location), ''), nullif(trim(ocr_text), '')),
                '\s+', ' ', 'g')))
            WHERE search_text IS NULL OR btrim(search_text) = '';
        </sql>
    </changeSet>

    <!-- focus_group -->
    <changeSet id="20261115020000-7" author="system">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="focus_group"/>
            <not><columnExists tableName="focus_group" columnName="ocr_text"/></not>
        </preConditions>
        <addColumn tableName="focus_group">
            <column name="ocr_text" type="text"><constraints nullable="true"/></column>
        </addColumn>
    </changeSet>
    <changeSet id="20261115020000-8" author="system">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="focus_group"/>
            <not><columnExists tableName="focus_group" columnName="search_text"/></not>
