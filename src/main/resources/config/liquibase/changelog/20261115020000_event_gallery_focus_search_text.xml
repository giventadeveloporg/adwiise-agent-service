    <changeSet id="20261115020000-9" author="system">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="focus_group" columnName="search_text"/>
        </preConditions>
        <sql>
            UPDATE public.focus_group
            SET search_text = lower(trim(regexp_replace(
                concat_ws(' ', nullif(trim(name), ''), nullif(trim(slug), ''), nullif(trim(description), ''), nullif(trim(ocr_text), '')),
                '\s+', ' ', 'g')))
            WHERE search_text IS NULL OR btrim(search_text) = '';
        </sql>
    </changeSet>
</databaseChangeLog>
